<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                "Open with puzPlayer" for puzzle files in other apps.
                Email apps and file managers rarely know these file types, so
                .puz/.ipuz/.jpz files usually arrive as application/octet-stream
                (generic binary). Accepting that type is what makes the app
                show up for attachments; the app checks the contents and says
                so if a file isn't a crossword.
                A downloaded file keeps the type its website or email gave it,
                and apps like Firefox open it by a media-library address with
                no file name in it, so the type is all there is to go on.
                Sites such as AVCX send puzzle files with their server's label
                for an unknown file, so the usual ones are accepted too:
                binary/octet-stream (Amazon S3's default), application/unknown,
                application/force-download and application/x-download. Only
                those: broad types such as application/* would put the app in
                "Open with" for PDFs, documents and every other file.
                No scheme is listed on purpose: a type-only filter still
                takes content: and file: addresses, and it also answers apps
                that ask "who opens this type?" without an address (Samsung's
                My Files does), which a filter with schemes never matches.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/x-crossword" />
                <data android:mimeType="application/x-crossword-puzzle" />
                <data android:mimeType="application/vnd.crossword-puzzle" />
                <data android:mimeType="application/x-ipuz" />
                <data android:mimeType="application/x-jpz" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="binary/octet-stream" />
                <data android:mimeType="application/unknown" />
                <data android:mimeType="application/force-download" />
                <data android:mimeType="application/x-download" />
            </intent-filter>

            <!-- Files whose name is part of the address, from file managers
                 that do: matched by extension whatever type they are given. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.puz" />
                <data android:pathPattern=".*\\..*\\.puz" />
                <data android:pathPattern=".*\\..*\\..*\\.puz" />
                <data android:pathPattern=".*\\.ipuz" />
                <data android:pathPattern=".*\\..*\\.ipuz" />
                <data android:pathPattern=".*\\..*\\..*\\.ipuz" />
                <data android:pathPattern=".*\\.jpz" />
                <data android:pathPattern=".*\\..*\\.jpz" />
                <data android:pathPattern=".*\\..*\\..*\\.jpz" />
            </intent-filter>

            <!-- The same, for apps that give no type at all. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.puz" />
                <data android:pathPattern=".*\\..*\\.puz" />
                <data android:pathPattern=".*\\..*\\..*\\.puz" />
                <data android:pathPattern=".*\\.ipuz" />
                <data android:pathPattern=".*\\..*\\.ipuz" />
                <data android:pathPattern=".*\\..*\\..*\\.ipuz" />
                <data android:pathPattern=".*\\.jpz" />
                <data android:pathPattern=".*\\..*\\.jpz" />
                <data android:pathPattern=".*\\..*\\..*\\.jpz" />
            </intent-filter>

            <!-- "Share" to puzPlayer. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-crossword" />
                <data android:mimeType="application/x-crossword-puzzle" />
                <data android:mimeType="application/vnd.crossword-puzzle" />
                <data android:mimeType="application/x-ipuz" />
                <data android:mimeType="application/x-jpz" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="binary/octet-stream" />
                <data android:mimeType="application/unknown" />
                <data android:mimeType="application/force-download" />
                <data android:mimeType="application/x-download" />
            </intent-filter>
        </activity>
    </application>

</manifest>
